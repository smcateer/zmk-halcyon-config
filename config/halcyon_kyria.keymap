#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM  1
#define FUNC 2
#define NAV  3
#define SYM  4

/ {
    behaviors {
        /*
         * Home-row mods.
         *
         * Approximation of the Voyager:
         *   FLOW_TAP_TERM 100
         *   CHORDAL_HOLD
         *   PERMISSIVE_HOLD
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Left";

            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Right";

            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                41 42 43 44
            >;

            hold-trigger-on-release;
        };

        /*
         * Other Voyager tap/hold keys.
         * Same positional/chordal logic, but without Flow Tap.
         */
        phtl: positional_hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional Hold Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        phtr: positional_hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional Hold Tap Right";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                41 42 43 44
            >;

            hold-trigger-on-release;
        };

        /*
         * Voyager DUAL_FUNC_1:
         * tap = Tab
         * hold = return to Base
         */
        phtl_to: positional_hold_tap_to_layer_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Layer Return Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&to>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        /*
         * Meh on hold / horizontal-wheel-left on tap.
         */
        phtl_scroll: positional_hold_tap_scroll_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Scroll Hold Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&msc>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        /*
         * Kyria encoder "none" action
         */
        noop_sensor: noop_sensor {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    /*
     * This is the one Voyager macro retained:
     * "&c."
     */
    macros {
        m_amp_c_dot: macro_amp_c_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            tap-ms = <30>;
            bindings = <&kp AMPS &kp C &kp DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Each layer's bindings property is one flat 60-position list.
         * Formatting is purely for humans: one position per line, comments
         * show absolute position numbers, and a blank line separates hands.
         */

        base_layer {
            display-name = "Base";

            bindings = <
                // Row 0, left - positions 0-5
                &phtl LG(L) ESC   // 0
                &kp V             // 1
                &kp W             // 2
                &kp F             // 3
                &kp P             // 4
                &kp B             // 5

                // Row 0, right - positions 6-11
                &kp J             // 6
                &kp L             // 7
                &kp U             // 8
                &kp Y             // 9
                &kp SQT           // 10
                &caps_word        // 11

                // Row 1, left - positions 12-17
                &phtl LSHIFT TAB  // 12
                &hml LGUI R       // 13
                &hml LALT S       // 14
                &hml LCTRL T      // 15
                &hml LSHIFT H     // 16
                &hml LG(LS(LA(LCTRL))) K      // 17

                // Row 1, right - positions 18-23
                &hmr LG(LS(LA(LCTRL))) X      // 18
                &hmr LSHIFT N     // 19
                &hmr LCTRL A      // 20
                &hmr LALT I       // 21
                &hmr LGUI O       // 22
                &kp MINUS         // 23

                // Row 2, left - positions 24-29
                &kp ENTER         // 24
                &sk LSHIFT        // 25
                &kp C             // 26
                &kp G             // 27
                &kp D             // 28
                &hml LS(LA(LCTRL)) Q        // 29

                // Upper thumbs, left - positions 30-31
                &none             // 30
                &none             // 31

                // Upper thumbs, right - positions 32-33
                &none             // 32
                &none             // 33

                // Row 2, right - positions 34-39
                &hmr LS(LA(LCTRL)) Z        // 34
                &kp M             // 35
                &kp COMMA         // 36
                &kp DOT           // 37
                &sk LSHIFT        // 38
                &kp AT            // 39

                // Thumbs, left - positions 40-44
                &none             // 40
                &sl FUNC          // 41
                &sl NUM           // 42
                &kp E             // 43
                &sl NAV           // 44

                // Thumbs, right - positions 45-49
                &sl SYM           // 45
                &kp SPACE         // 46
                &none             // 47
                &kp BSPC          // 48
                &none             // 49

                // Encoder, left push action - position 50
                &kp ENTER         // 50

                // Blank, left - unused encoder key positions 51-54
                &none             // 51
                &none             // 52
                &none             // 53
                &none             // 54

                // Blank, right - unused encoder key positions 55-58
                &none             // 55
                &none             // 56
                &none             // 57
                &none             // 58

                // Encoder, right push action - position 59
                &kp ESC           // 59
            >;

            sensor-bindings =

                // Encoder, left twist actions (CW, CCW)
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,

                // Encoder, right twist actions (CW, CCW)
                <&inc_dec_kp PG_DN PG_UP>,

                // Blank, unused soldered encoders
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * NUM / MOUSE
         * Old Voyager layer 3.
         */
        num_layer {
            display-name = "Num / Mouse";

            bindings = <
                // Row 0, left - positions 0-5
                &tog NUM                    // 0
                &none                       // 1
                &kp DEL                     // 2
                &kp LC(MINUS)               // 3
                &kp LC(EQUAL)               // 4
                &none                       // 5

                // Row 0, right - positions 6-11
                &phtr LA(F4) C_AL_CALC      // 6
                &kp N7                      // 7
                &kp N8                      // 8
                &kp N9                      // 9
                &kp COLON                   // 10
                &none                       // 11

                // Row 1, left - positions 12-17
                &phtl_to BASE TAB               // 12
                &phtl LGUI FSLH             // 13
                &phtl LALT STAR             // 14
                &phtl LCTRL MINUS           // 15
                &phtl LSHIFT PLUS           // 16
                &phtl LG(LS(LA(LCTRL))) EQUAL           // 17

                // Row 1, right - positions 18-23
                &kp LG(LS(LA(LCTRL)))                   // 18
                &phtr LSHIFT N4             // 19
                &phtr LCTRL N5              // 20
                &phtr LALT N6               // 21
                &phtr LGUI N0               // 22
                &none                       // 23

                // Row 2, left - positions 24-29
                &trans                      // 24
                &mkp MB4                    // 25
                &mkp MB2                    // 26
                &mkp MB3                    // 27
                &mkp MB1                    // 28
                &phtl_scroll LS(LA(LCTRL)) SCRL_LEFT  // 29

                // Upper thumbs, left - positions 30-31
                &none                       // 30
                &none                       // 31

                // Upper thumbs, right - positions 32-33
                &none                       // 32
                &none                       // 33

                // Row 2, right - positions 34-39
                &kp LS(LA(LCTRL))                     // 34
                &kp N1                      // 35
                &kp N2                      // 36
                &kp N3                      // 37
                &kp DOT                     // 38
                &none                       // 39

                // Thumbs, left - positions 40-44
                &none                       // 40
                &trans                      // 41
                &trans                      // 42
                &trans                      // 43
                &trans                      // 44

                // Thumbs, right - positions 45-49
                &trans                      // 45
                &trans                      // 46
                &none                       // 47
                &trans                      // 48
                &none                       // 49

                // Encoder, left push action - position 50
                &trans                       // 50

                // Blank, left - unused encoder key positions 51-54
                &none                       // 51
                &none                       // 52
                &none                       // 53
                &none                       // 54

                // Blank, right - unused encoder key positions 55-58
                &none                       // 55
                &none                       // 56
                &none                       // 57
                &none                       // 58

                // Encoder, right push action - position 59
                &trans                      // 59
            >;

            sensor-bindings =

                // Encoder, left twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Encoder, right twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Blank, unused soldered encoders
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * FUNCTION
         * Old Voyager layer 4.
         *
         * The two old RGB controls are now &none.
         */
        function_layer {
            display-name = "Function";

            bindings = <
                // Row 0, left - positions 0-5
                &tog FUNC                   // 0
                &trans                      // 1
                &none                       // 2
                &kp LC(LS(TAB))             // 3
                &kp LC(TAB)                 // 4
                &kp LG(TAB)                 // 5

                // Row 0, right - positions 6-11
                &kp INS                     // 6
                &kp F7                      // 7
                &kp F8                      // 8
                &kp F9                      // 9
                &kp F10                     // 10
                &trans                      // 11

                // Row 1, left - positions 12-17
                &phtl_to BASE TAB               // 12
                &kp LGUI                    // 13
                &kp LALT                    // 14
                &phtl LCTRL LG(LC(LEFT))    // 15
                &phtl LSHIFT LG(LC(RIGHT))  // 16
                &kp LG(LS(LA(LCTRL)))                   // 17

                // Row 1, right - positions 18-23
                &kp SCROLLLOCK              // 18
                &kp F4                      // 19
                &kp F5                      // 20
                &kp F6                      // 21
                &kp F11                     // 22
                &none                       // 23

                // Row 2, left - positions 24-29
                &trans                      // 24
                &none                       // 25
                &none                       // 26
                &kp LA(LC(LS(TAB)))         // 27
                &kp LA(LC(TAB))             // 28
                &kp LS(LA(LCTRL))                     // 29

                // Upper thumbs, left - positions 30-31
                &none                       // 30
                &none                       // 31

                // Upper thumbs, right - positions 32-33
                &none                       // 32
                &none                       // 33

                // Row 2, right - positions 34-39
                &none                       // 34
                &kp F1                      // 35
                &kp F2                      // 36
                &kp F3                      // 37
                &kp F12                     // 38
                &none                       // 39

                // Thumbs, left - positions 40-44
                &none                       // 40
                &trans                      // 41
                &trans                      // 42
                &trans                      // 43
                &trans                      // 44

                // Thumbs, right - positions 45-49
                &trans                      // 45
                &trans                      // 46
                &none                       // 47
                &trans                      // 48
                &none                       // 49

                // Encoder, left push action - position 50
                &trans                      // 50

                // Blank, left - unused encoder key positions 51-54
                &none                       // 51
                &none                       // 52
                &none                       // 53
                &none                       // 54

                // Blank, right - unused encoder key positions 55-58
                &none                       // 55
                &none                       // 56
                &none                       // 57
                &none                       // 58

                // Encoder, right push action - position 59
                &trans                      // 59
            >;

            sensor-bindings =

                // Encoder, left twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Encoder, right twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Blank, unused soldered encoders
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * NAVIGATION
         * Old Voyager layer 5.
         */
        nav_layer {
            display-name = "Navigation";

            bindings = <
                // Row 0, left - positions 0-5
                &tog NAV               // 0
                &kp PRINTSCREEN        // 1
                &kp LC(A)              // 2
                &kp LC(Z)              // 3
                &kp LC(Y)              // 4
                &kp LC(R)              // 5

                // Row 0, right - positions 6-11
                &kp LC(B)              // 6
                &kp HOME               // 7
                &kp PG_DN              // 8
                &kp PG_UP              // 9
                &kp END                // 10
                &kp CAPSLOCK           // 11

                // Row 1, left - positions 12-17
                &phtl_to BASE TAB          // 12
                &kp LGUI               // 13
                &kp LALT               // 14
                &kp LCTRL              // 15
                &kp LSHIFT             // 16
                &kp LG(LS(LA(LCTRL)))              // 17

                // Row 1, right - positions 18-23
                &kp LC(I)              // 18
                &kp LEFT               // 19
                &kp DOWN               // 20
                &kp UP                 // 21
                &kp RIGHT              // 22
                &kp K_APPLICATION      // 23

                // Row 2, left - positions 24-29
                &trans                 // 24
                &kp LC(X)              // 25
                &phtl LC(LS(C)) LC(C)  // 26
                &phtl LC(LS(V)) LC(V)  // 27
                &kp LG(V)              // 28
                &phtl LS(LA(LCTRL)) C_AC_BACK    // 29

                // Upper thumbs, left - positions 30-31
                &none                  // 30
                &none                  // 31

                // Upper thumbs, right - positions 32-33
                &none                  // 32
                &none                  // 33

                // Row 2, right - positions 34-39
                &kp LC(U)              // 34
                &none                  // 35
                &none                  // 36
                &none                  // 37
                &none                  // 38
                &trans                 // 39

                // Thumbs, left - positions 40-44
                &none                  // 40
                &trans                 // 41
                &trans                 // 42
                &trans                 // 43
                &trans                 // 44

                // Thumbs, right - positions 45-49
                &trans                 // 45
                &trans                 // 46
                &none                  // 47
                &kp LC(BSPC)           // 48
                &none                  // 49

                // Encoder, left push action - position 50
                &trans                 // 50

                // Blank, left - unused encoder key positions 51-54
                &none                  // 51
                &none                  // 52
                &none                  // 53
                &none                  // 54

                // Blank, right - unused encoder key positions 55-58
                &none                  // 55
                &none                  // 56
                &none                  // 57
                &none                  // 58

                // Encoder, right push action - position 59
                &trans                 // 59
            >;

            sensor-bindings =

                // Encoder, left twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Encoder, right twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Blank, unused soldered encoders
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * SYMBOLS
         * Old Voyager layer 6.
         */
        sym_layer {
            display-name = "Symbols";

            bindings = <
                // Row 0, left - positions 0-5
                &tog SYM           // 0
                &none              // 1
                &none              // 2
                &kp TILDE          // 3
                &kp GRAVE          // 4
                &none              // 5

                // Row 0, right - positions 6-11
                &none              // 6
                &kp LBKT           // 7
                &kp RBKT           // 8
                &kp LBRC           // 9
                &kp RBRC           // 10
                &kp LA(RBKT)       // 11

                // Row 1, left - positions 12-17
                &phtl_to BASE TAB      // 12
                &phtl LGUI BSLH    // 13
                &phtl LALT PRCNT   // 14
                &phtl LCTRL HASH   // 15
                &phtl LSHIFT DLLR  // 16
                &kp LG(LS(LA(LCTRL)))          // 17

                // Row 1, right - positions 18-23
                &kp LG(LS(LA(LCTRL)))          // 18
                &phtr LSHIFT AMPS  // 19
                &phtr LCTRL QMARK  // 20
                &phtr LALT LPAR    // 21
                &phtr LGUI RPAR    // 22
                &m_amp_c_dot       // 23

                // Row 2, left - positions 24-29
                &trans             // 24
                &none              // 25
                &kp CARET          // 26
                &kp LS(COMMA)      // 27
                &kp LS(DOT)        // 28
                &kp LS(LA(LCTRL))            // 29

                // Upper thumbs, left - positions 30-31
                &none              // 30
                &none              // 31

                // Upper thumbs, right - positions 32-33
                &none              // 32
                &none              // 33

                // Row 2, right - positions 34-39
                &kp LS(LA(LCTRL))            // 34
                &kp COLON          // 35
                &kp EXCL           // 36
                &kp SEMI           // 37
                &kp PIPE           // 38
                &kp LC(RIGHT)      // 39

                // Thumbs, left - positions 40-44
                &none              // 40
                &trans             // 41
                &trans             // 42
                &trans             // 43
                &trans             // 44

                // Thumbs, right - positions 45-49
                &trans             // 45
                &trans             // 46
                &none              // 47
                &trans             // 48
                &none              // 49

                // Encoder, left push action - position 50
                &trans             // 50

                // Blank, left - unused encoder key positions 51-54
                &none              // 51
                &none              // 52
                &none              // 53
                &none              // 54

                // Blank, right - unused encoder key positions 55-58
                &none              // 55
                &none              // 56
                &none              // 57
                &none              // 58

                // Encoder, right push action - position 59
                &trans             // 59
            >;

            sensor-bindings =

                // Encoder, left twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Encoder, right twist actions (CW, CCW)
                // Commented out for transparency
                //<&noop_sensor>,

                // Blank, unused soldered encoders
                <&noop_sensor>,
                <&noop_sensor>;
        };
    };
};
