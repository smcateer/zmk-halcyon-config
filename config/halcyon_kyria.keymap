#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM  1
#define FUNC 2
#define NAV  3
#define SYM  4

/ {
    behaviors {
        /*
         * Home-row mods.
         *
         * Approximation of the Voyager:
         *   FLOW_TAP_TERM 100
         *   CHORDAL_HOLD
         *   PERMISSIVE_HOLD
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Left";

            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Right";

            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                41 42 43 44
            >;

            hold-trigger-on-release;
        };

        /*
         * Other Voyager tap/hold keys.
         * Same positional/chordal logic, but without Flow Tap.
         */
        phtl: positional_hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional Hold Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        phtr: positional_hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional Hold Tap Right";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                41 42 43 44
            >;

            hold-trigger-on-release;
        };

        /*
         * Voyager DUAL_FUNC_1:
         * tap = Tab
         * hold = return to Base
         */
        phtl_to: positional_hold_tap_to_layer_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Layer Return Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&to>, <&kp>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        /*
         * MEH on hold / horizontal-wheel-left on tap.
         */
        phtl_scroll: positional_hold_tap_scroll_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Scroll Hold Tap Left";

            flavor = "balanced";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&msc>;

            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                34 35 36 37 38 39
                45 46 48
            >;

            hold-trigger-on-release;
        };

        /*
         * Kyria encoder rotation deliberately does nothing for now.
         */
        noop_sensor: noop_sensor {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    /*
     * This is the one Voyager macro retained:
     * "&c."
     */
    macros {
        m_amp_c_dot: macro_amp_c_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            tap-ms = <30>;
            bindings = <&kp AMPS &kp C &kp DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE
         *
         * Thumb cluster:
         *
         *   --  FUNC  NUM   E   NAV | SYM  Space  --  Bspc  --
         *
         * The "--" between Space and Backspace is the former
         * Voyager dubs-layer key.
         */
        base_layer {
            display-name = "Base";

            bindings = <
&phtl LG(L) ESC   &kp V            &kp W            &kp F            &kp P                     &kp B                                      &kp J                     &kp L            &kp U            &kp Y            &kp SQT          &caps_word
&phtl LSHIFT TAB  &hml LGUI R      &hml LALT S      &hml LCTRL T    &hml LSHIFT H              &hml LG(LS(LA(LCTRL))) K                  &hmr LG(LS(LA(LCTRL))) X  &hmr LSHIFT N    &hmr LCTRL A     &hmr LALT I      &hmr LGUI O      &kp MINUS
&kp ENTER         &sk LSHIFT       &kp C             &kp G            &kp D                     &hml LS(LA(LCTRL)) Q   &none &none &none &none   &hmr LS(LA(LCTRL)) Z      &kp M            &kp COMMA        &kp DOT          &sk LSHIFT       &kp AT
                                                     &none            &sl FUNC                  &sl NUM                  &kp E  &sl NAV  &sl SYM  &kp SPACE       &none             &kp BSPC         &none
&none             &none            &none             &none            &none                                                                    &none            &none             &none            &none            &none
            >;

            sensor-bindings =
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * NUM / MOUSE
         * Old Voyager layer 3.
         */
        num_layer {
            display-name = "Num / Mouse";

            bindings = <
&tog NUM          &none            &kp DEL            &kp LC(MINUS)      &kp LC(EQUAL)       &none                                  &phtr LA(F4) C_AL_CALC       &kp N7          &kp N8          &kp N9          &kp COLON     &none
&phtl_to BASE TAB &phtl LGUI FSLH  &phtl LALT STAR   &phtl LCTRL MINUS  &phtl LSHIFT PLUS   &phtl LG(LS(LA(LCTRL))) EQUAL          &kp LG(LS(LA(LCTRL)))        &phtr LSHIFT N4 &phtr LCTRL N5 &phtr LALT N6  &phtr LGUI N0 &none
&trans            &mkp MB4         &mkp MB2           &mkp MB3           &mkp MB1            &phtl_scroll LS(LA(LCTRL)) SCRL_LEFT   &none &none &none &none    &kp LS(LA(LCTRL))             &kp N1          &kp N2          &kp N3          &kp DOT       &none
                                                      &none              &trans                &trans                                  &trans &trans &trans   &trans                         &none            &trans           &none
&none             &none            &none              &none              &none                                                                                       &none           &none           &none           &none         &none
            >;

            sensor-bindings =
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * FUNCTION
         * Old Voyager layer 4.
         *
         * The two old RGB controls are now &none.
         */
        function_layer {
            display-name = "Function";

            bindings = <
&tog FUNC         &trans       &none                   &kp LC(LS(TAB))            &kp LC(TAB)                &kp LG(TAB)                         &kp INS          &kp F7   &kp F8   &kp F9   &kp F10  &trans
&phtl_to BASE TAB &kp LGUI     &kp LALT               &phtl LCTRL LG(LC(LEFT))   &phtl LSHIFT LG(LC(RIGHT)) &kp LG(LS(LA(LCTRL)))              &kp SCROLLLOCK   &kp F4   &kp F5   &kp F6   &kp F11  &none
&trans            &none        &none                   &kp LA(LC(LS(TAB)))        &kp LA(LC(TAB))             &kp LS(LA(LCTRL))   &none &none &none &none  &none            &kp F1   &kp F2   &kp F3   &kp F12  &none
                                                     &none                      &trans                       &trans                &trans &trans &trans       &trans           &none    &trans    &none
&none             &none        &none                   &none                      &none                                                              &none            &none    &none    &none    &none
            >;

            sensor-bindings =
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * NAVIGATION
         * Old Voyager layer 5.
         */
        nav_layer {
            display-name = "Navigation";

            bindings = <
&tog NAV          &kp PRINTSCREEN  &kp LC(A)              &kp LC(Z)               &kp LC(Y)              &kp LC(R)                                  &kp LC(B)    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp CAPSLOCK
&phtl_to BASE TAB &kp LGUI         &kp LALT               &kp LCTRL               &kp LSHIFT              &kp LG(LS(LA(LCTRL)))                      &kp LC(I)    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp K_APPLICATION
&trans            &kp LC(X)        &phtl LC(LS(C)) LC(C) &phtl LC(LS(V)) LC(V)  &kp LG(V)               &phtl LS(LA(LCTRL)) C_AC_BACK   &none &none &none &none  &kp LC(U)    &none     &none      &none      &none      &trans
                                                         &none                   &trans                   &trans                           &trans &trans &trans       &trans       &none      &kp LC(BSPC) &none
&none             &none            &none                  &none                    &none                                                         &none        &none      &none      &none      &none
            >;

            sensor-bindings =
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>;
        };

        /*
         * SYMBOLS
         * Old Voyager layer 6.
         */
        sym_layer {
            display-name = "Symbols";

            bindings = <
&tog SYM          &none            &none             &kp TILDE        &kp GRAVE          &none                                      &none                       &kp LBKT          &kp RBKT          &kp LBRC        &kp RBRC        &kp LA(RBKT)
&phtl_to BASE TAB &phtl LGUI BSLH &phtl LALT PRCNT &phtl LCTRL HASH &phtl LSHIFT DLLR  &kp LG(LS(LA(LCTRL)))                      &kp LG(LS(LA(LCTRL)))       &phtr LSHIFT AMPS &phtr LCTRL QMARK &phtr LALT LPAR &phtr LGUI RPAR &m_amp_c_dot
&trans            &none            &kp CARET         &kp LS(COMMA)    &kp LS(DOT)        &kp LS(LA(LCTRL))   &none &none &none &none &kp LS(LA(LCTRL))          &kp COLON         &kp EXCL          &kp SEMI         &kp PIPE         &kp LC(RIGHT)
                                                   &none            &trans             &trans              &trans &trans &trans        &trans                      &none              &trans             &none
&none             &none            &none             &none            &none                                                                     &none              &none              &none             &none             &none
            >;

            sensor-bindings =
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>,
                <&noop_sensor>;
        };
    };
};
